      AdditionalFigurePosition: 0
      AdditionalFigureSprite: {fileID: 0}
      TertiaryFigurePosition: 0
      TertiaryFigureSprite: {fileID: 0}
      HideFiguresAfterDialogue: 1
  - Entries:
    - SpeakerName: 
      DialogueText: "\uD68C\uC0C9 \uBE14\uB85D\uC758 \uACBD\uC6B0, \uAC00\uB85C \uC138\uB85C
        \uB300\uAC01\uC120\uC73C\uB85C \uC778\uC811\uD55C \uACF3\uC5D0 \uBCF4\uB77C\uC0C9
        \uC601\uD63C\uC744 \uD558\uB098\uB9CC \uBC30\uCE58\uD574\uB3C4 \uBC14\uB85C
        \uBCF4\uB77C\uC0C9\uC73C\uB85C \uBCC0\uD569\uB2C8\uB2E4."
      StateToTrigger: 5
      StateTriggerTiming: 1
      FigurePosition: 0
      FigureSprite: {fileID: 0}
      AdditionalFigurePosition: 0
      AdditionalFigureSprite: {fileID: 0}
      TertiaryFigurePosition: 0
      TertiaryFigureSprite: {fileID: 0}
      HideFiguresAfterDialogue: 1
    - SpeakerName: 
      DialogueText: "\uD45C\uC2DC\uB41C \uC704\uCE58\uC5D0 \uBE14\uB85D\uC744 \uBC30\uCE58\uD574
        \uBCF4\uC138\uC694."
      StateToTrigger: 6
      StateTriggerTiming: 0
      FigurePosition: 0
      FigureSprite: {fileID: 0}
      AdditionalFigurePosition: 0
      AdditionalFigureSprite: {fileID: 0}
      TertiaryFigurePosition: 0
      TertiaryFigureSprite: {fileID: 0}
      HideFiguresAfterDialogue: 1
  - Entries:
    - SpeakerName: 
      DialogueText: "\uBAA9\uD45C\uCE58\uB9CC\uD07C \uAC80\uC740 \uBE14\uB85D\uC744
        \uBCC0\uD658\uD558\uBA74 \uC774\uAE41\uB2C8\uB2E4."
      StateToTrigger: 7
      StateTriggerTiming: 1
      FigurePosition: 0
      FigureSprite: {fileID: 0}
      AdditionalFigurePosition: 0
      AdditionalFigureSprite: {fileID: 0}
      TertiaryFigurePosition: 0
      TertiaryFigureSprite: {fileID: 0}
      HideFiguresAfterDialogue: 0
    - SpeakerName: 
      DialogueText: "\uAE30\uC874\uC5D0 \uAC80\uC740 \uBE14\uB85D\uC774 \uC704\uCE58\uD588\uB358
        \uCE78\uB4E4\uC744 \uBCF4\uB77C\uC0C9\uC73C\uB85C \uBC14\uAFC0 \uB54C\uC5D0\uB9CC
        \uCE74\uC6B4\uD2B8\uAC00 \uC62C\uB77C\uAC11\uB2C8\uB2E4."
      StateToTrigger: 8
      StateTriggerTiming: 1
      FigurePosition: 0
      FigureSprite: {fileID: 0}
      AdditionalFigurePosition: 0
      AdditionalFigureSprite: {fileID: 0}
      TertiaryFigurePosition: 0
      TertiaryFigureSprite: {fileID: 0}
      HideFiguresAfterDialogue: 0
    - SpeakerName: 
      DialogueText: "\uD574\uB2F9 \uCE78\uB4E4\uC740 \uD551\uD06C\uC0C9 \uD14C\uB450\uB9AC\uB85C
        \uAD6C\uBD84\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
      StateToTrigger: 8
      StateTriggerTiming: 1
      FigurePosition: 0
      FigureSprite: {fileID: 0}
      AdditionalFigurePosition: 0
      AdditionalFigureSprite: {fileID: 0}
      TertiaryFigurePosition: 0
      TertiaryFigureSprite: {fileID: 0}
      HideFiguresAfterDialogue: 0
    - SpeakerName: 
      DialogueText: "\uD37C\uC990\uC744 \uC77C\uC815 \uAC1C\uC218\uB9CC\uD07C \uD480\uBA74
        \uB2E4\uC74C \uC0AC\uB78C\uC73C\uB85C \uB118\uC5B4\uAC08 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
