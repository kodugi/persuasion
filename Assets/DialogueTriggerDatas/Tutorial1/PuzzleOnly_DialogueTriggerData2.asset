    - SpeakerName: 
      DialogueText: "\uD68C\uC0C9 \uBE14\uB85D\uC740 \uAC80\uC740 \uBE14\uB85D\uACFC
        \uAC19\uC740 \uCDE8\uAE09\uC744 \uBC1B\uC2B5\uB2C8\uB2E4."
      StateToTrigger: 9
      StateTriggerTiming: 1
      FigurePosition: 0
