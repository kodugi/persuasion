  _pages:
  - Entries:
    - SpeakerName: 
      DialogueText: "\uC2DC\uC2A4\uD15C\uC758 \uD134\uC5D0\uC11C\uB294 \uAC80\uC740\uC0C9
        \uBE14\uB85D \uC0AC\uC774\uC5D0 \uB07C\uC778 \uBCF4\uB77C\uC0C9 \uBE14\uB85D\uC774
        \uD68C\uC0C9\uC73C\uB85C \uBCC0\uD658\uB429\uB2C8\uB2E4."
