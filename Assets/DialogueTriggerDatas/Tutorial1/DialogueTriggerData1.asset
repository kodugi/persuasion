  _turn: 0
  _turnState: 1
  _pages:
  - Entries:
    - SpeakerName: "\uB098"
      DialogueText: "\u2026!"
      StateToTrigger: 0
      StateTriggerTiming: 0
      FigurePosition: 3
      FigureSprite: {fileID: 21300000, guid: 9c80d18f42f4cb74294a6793b6068d08, type: 3}
      AdditionalFigurePosition: 0
      AdditionalFigureSprite: {fileID: 0}
      TertiaryFigurePosition: 0
      TertiaryFigureSprite: {fileID: 0}
      HideFiguresAfterDialogue: 0
    - SpeakerName: 
      DialogueText: "\uB0A8\uC790\uC758 \uBA38\uB9BF\uC18D\uC744 \uCC44\uC6B0\uB294
        \uAC10\uC815\uB4E4\uC774 \uC120\uBA85\uD558\uAC8C \uBCF4\uC774\uAE30 \uC2DC\uC791\uD588\uB2E4."
      StateToTrigger: 0
      StateTriggerTiming: 0
      FigurePosition: 3
      FigureSprite: {fileID: 0}
      AdditionalFigurePosition: 0
      AdditionalFigureSprite: {fileID: 0}
      TertiaryFigurePosition: 0
      TertiaryFigureSprite: {fileID: 0}
      HideFiguresAfterDialogue: 0
    - SpeakerName: "\uB098"
      DialogueText: "\uB410\uB2E4\u2026! \uB2E4\uD589\uC774\uB2E4. \uBB34\uC0AC\uD788
        \uC811\uC18D\uD588\uC5B4."
      StateToTrigger: 0
      StateTriggerTiming: 0
      FigurePosition: 3
      FigureSprite: {fileID: 21300000, guid: 9c80d18f42f4cb74294a6793b6068d08, type: 3}
      AdditionalFigurePosition: 0
      AdditionalFigureSprite: {fileID: 0}
      TertiaryFigurePosition: 0
      TertiaryFigureSprite: {fileID: 0}
      HideFiguresAfterDialogue: 0
    - SpeakerName: "\uB098"
      DialogueText: "\uC624\uB79C\uB9CC\uC774\uB77C \uD560 \uC218 \uC788\uC744\uAE4C
        \uAC71\uC815\uD588\uB294\uB370\u2026."
      StateToTrigger: 0
      StateTriggerTiming: 0
      FigurePosition: 0
      FigureSprite: {fileID: 0}
      AdditionalFigurePosition: 0
      AdditionalFigureSprite: {fileID: 0}
      TertiaryFigurePosition: 0
      TertiaryFigureSprite: {fileID: 0}
      HideFiguresAfterDialogue: 0
    - SpeakerName: 
      DialogueText: "\uB77C\uC774\uD130\uC5D0 \uBD88\uC744 \uBD99\uC774\uB824\uB358
        \uB0A8\uC790\uAC00 \uC7A0\uC2DC \uBA48\uCE6B\uD558\uB294 \uAC83\uC774 \uBCF4\uC600\uB2E4."
      StateToTrigger: 0
      StateTriggerTiming: 0
      FigurePosition: 3
      FigureSprite: {fileID: 0}
      AdditionalFigurePosition: 2
      AdditionalFigureSprite: {fileID: 21300000, guid: fed65235d5e64754fa19d658727eaea8, type: 3}
      TertiaryFigurePosition: 1
      TertiaryFigureSprite: {fileID: 0}
      HideFiguresAfterDialogue: 0
    - SpeakerName: 
      DialogueText: "\uB0A8\uC790\uB294 \uD55C \uC190\uC73C\uB85C \uBA38\uB9AC\uB97C
        \uBD80\uC5EC\uC7A1\uC740 \uCC44 \uADF8 \uC790\uB9AC\uC5D0\uC11C \uADF8\uB300\uB85C
        \uAD73\uC5C8\uB2E4."
      StateToTrigger: 0
      StateTriggerTiming: 0
      FigurePosition: 0
      FigureSprite: {fileID: 0}
      AdditionalFigurePosition: 0
      AdditionalFigureSprite: {fileID: 0}
      TertiaryFigurePosition: 0
      TertiaryFigureSprite: {fileID: 0}
      HideFiguresAfterDialogue: 0
    - SpeakerName: "\uB098"
      DialogueText: "(\uB2F9\uC5F0\uD55C \uC77C\uC774\uC57C.... \uB204\uAC00 \uBA38\uB9BF\uC18D\uC5D0
        \uC811\uC18D\uD558\uB294 \uAC74 \uCC98\uC74C \uACBD\uD5D8\uD574\uBCF4\uB294
        \uC77C\uC77C \uD14C\uB2C8\uAE4C.)"
      StateToTrigger: 0
      StateTriggerTiming: 0
      FigurePosition: 2
      FigureSprite: {fileID: 21300000, guid: 9f7722c6ab0348b418d8400e510da437, type: 3}
      AdditionalFigurePosition: 0
      AdditionalFigureSprite: {fileID: 0}
      TertiaryFigurePosition: 0
      TertiaryFigureSprite: {fileID: 0}
      HideFiguresAfterDialogue: 0
    - SpeakerName: "\uB098"
      DialogueText: "(\uD63C\uB780\uC2A4\uB7FD\uACE0 \uC774\uC0C1\uD55C \uB290\uB08C\uC774
        \uB4E4\uACA0\uC9C0.)"
      StateToTrigger: 0
      StateTriggerTiming: 0
      FigurePosition: 0
      FigureSprite: {fileID: 0}
      AdditionalFigurePosition: 0
      AdditionalFigureSprite: {fileID: 0}
      TertiaryFigurePosition: 0
      TertiaryFigureSprite: {fileID: 0}
      HideFiguresAfterDialogue: 0
    - SpeakerName: "\uB098"
      DialogueText: "(\uC758\uB3C4\uD55C \uAC74 \uC544\uB2C8\uC9C0\uB9CC, \uB355\uBD84\uC5D0
        \uC2DC\uAC04\uC744 \uC880 \uBC8C\uC5C8\uB124.)"
      StateToTrigger: 0
      StateTriggerTiming: 0
      FigurePosition: 0
      FigureSprite: {fileID: 0}
      AdditionalFigurePosition: 0
      AdditionalFigureSprite: {fileID: 0}
      TertiaryFigurePosition: 0
      TertiaryFigureSprite: {fileID: 0}
      HideFiguresAfterDialogue: 0
    - SpeakerName: "\uB098"
      DialogueText: "(\uC815\uC2E0 \uCC28\uB9AC\uAE30 \uC804\uC5D0 \uC5BC\uB978 \uB05D\uB0B4\uC790.)"
      StateToTrigger: 0
      StateTriggerTiming: 0
      FigurePosition: 0
      FigureSprite: {fileID: 0}
      AdditionalFigurePosition: 0
      AdditionalFigureSprite: {fileID: 0}
      TertiaryFigurePosition: 0
      TertiaryFigureSprite: {fileID: 0}
      HideFiguresAfterDialogue: 0
    - SpeakerName: "\uB098"
      DialogueText: "\uC544, \uC774\uAC70 \uD55C 10\uB144 \uB9CC\uC5D0 \uCC98\uC74C
        \uD574\uBCF4\uB294\uB370\u2026. \uC5B4\uB5BB\uAC8C \uD558\uB354\uB77C?"
      StateToTrigger: 0
      StateTriggerTiming: 0
      FigurePosition: 3
      FigureSprite: {fileID: 21300000, guid: ce16addfed2994a47824eebf1086a4f5, type: 3}
      AdditionalFigurePosition: 1
      AdditionalFigureSprite: {fileID: 21300000, guid: fed65235d5e64754fa19d658727eaea8, type: 3}
      TertiaryFigurePosition: 2
      TertiaryFigureSprite: {fileID: 0}
      HideFiguresAfterDialogue: 0
    - SpeakerName: "\uB098"
      DialogueText: "\uC74C, \uC77C\uB2E8\u2026. \uC800 \uAC80\uC815\uC0C9 \uAC10\uC815\uB4E4\uC744
        \uB098\uD55C\uD14C \uD638\uC758\uC801\uC778 \uAC10\uC815\uC73C\uB85C \uBC14\uAFD4\uC57C
        \uC774 \uC0AC\uB78C\uC774 \uB098\uC5D0 \uB300\uD55C \uC758\uC2EC\uC744 \uAC70\uB450\uAC8C
        \uB420 \uAC70\uC57C."
      StateToTrigger: 0
      StateTriggerTiming: 0
      FigurePosition: 0
      FigureSprite: {fileID: 0}
      AdditionalFigurePosition: 0
      AdditionalFigureSprite: {fileID: 0}
      TertiaryFigurePosition: 0
      TertiaryFigureSprite: {fileID: 0}
      HideFiguresAfterDialogue: 0
    - SpeakerName: "\uB098"
      DialogueText: "\uADF8\uB7EC\uB824\uBA74 \uC774 \uC0AC\uB78C\uC758 \uBA38\uB9BF\uC18D\uC5D0
        \uB0B4 \uC601\uD63C\uC758 \uC870\uAC01\uC744 \uC2EC\uC5B4 \uB123\uC5B4\uC57C
        \uD574."
      StateToTrigger: 0
      StateTriggerTiming: 0
      FigurePosition: 0
      FigureSprite: {fileID: 0}
      AdditionalFigurePosition: 0
      AdditionalFigureSprite: {fileID: 0}
      TertiaryFigurePosition: 0
      TertiaryFigureSprite: {fileID: 0}
      HideFiguresAfterDialogue: 0
    - SpeakerName: "\uB098"
      DialogueText: "\uB0B4\uAC00 \uC758\uC2EC\uD560 \uD544\uC694 \uC5C6\uB294 \uC0AC\uB78C\uC774\uB77C\uB294
        \uAC78 \uC8FC\uC7A5\uD558\uBA74\uC11C \uB0B4 \uB9D0\uC5D0 \uC601\uD63C\uC744
        \uC0B4\uC9DD \uC11E\uC73C\uBA74, \uB0B4\uAC00 \uD558\uB294 \uB9D0\uC744 \uB4E3\uB294
        \uACFC\uC815\uC5D0\uC11C \uC601\uD63C\uC774 \uC774 \uC0AC\uB78C\uC758 \uBA38\uB9BF\uC18D\uC73C\uB85C
        \uB4E4\uC5B4\uAC08 \uAC70\uC57C."
      StateToTrigger: 0
      StateTriggerTiming: 0
      FigurePosition: 0
      FigureSprite: {fileID: 0}
      AdditionalFigurePosition: 0
      AdditionalFigureSprite: {fileID: 0}
      TertiaryFigurePosition: 0
      TertiaryFigureSprite: {fileID: 0}
      HideFiguresAfterDialogue: 0
    - SpeakerName: "\uB098"
      DialogueText: "\u2026.\uC77C\uB2E8 \uD55C \uBC88 \uD574\uBCFC\uAE4C."
      StateToTrigger: 1
      StateTriggerTiming: 0
      FigurePosition: 0
      FigureSprite: {fileID: 0}
      AdditionalFigurePosition: 0
      AdditionalFigureSprite: {fileID: 0}
      TertiaryFigurePosition: 0
      TertiaryFigureSprite: {fileID: 0}
      HideFiguresAfterDialogue: 0
    - SpeakerName: "\uB098"
      DialogueText: "\uC800\uAE30\uC694\u2026. \uC65C \uADF8\uB807\uAC8C \uC0DD\uAC01\uD558\uC2E0
        \uAC74\uC9C0\uB294 \uBAA8\uB974\uACA0\uB294\uB370, \uC804 \uADF8\uB0E5 \uD3C9\uBC94\uD55C
        \uC0AC\uB78C\uC774\uC5D0\uC694. \uADF8\uB0E5 \uB204\uAD74 \uC880 \uCC3E\uC73C\uB7EC
        \uC628 \uAC83 \uBFD0\uC778\uB370\u2026."
      StateToTrigger: 1
      StateTriggerTiming: 0
      FigurePosition: 0
      FigureSprite: {fileID: 0}
      AdditionalFigurePosition: 0
      AdditionalFigureSprite: {fileID: 0}
      TertiaryFigurePosition: 0
      TertiaryFigureSprite: {fileID: 0}
      HideFiguresAfterDialogue: 1
  - Entries:
    - SpeakerName: "\uB098"
      DialogueText: "\uC88B\uC544\u2026. \uC798 \uC790\uB9AC \uC7A1\uC740 \uAC83
        \uAC19\uB124."
      StateToTrigger: 0
      StateTriggerTiming: 0
      FigurePosition: 3
      FigureSprite: {fileID: 21300000, guid: 9f7722c6ab0348b418d8400e510da437, type: 3}
      AdditionalFigurePosition: 0
      AdditionalFigureSprite: {fileID: 0}
      TertiaryFigurePosition: 0
      TertiaryFigureSprite: {fileID: 0}
      HideFiguresAfterDialogue: 0
    - SpeakerName: "\uB098"
      DialogueText: "\uAC80\uC815\uC0C9 \uAC10\uC815\uC740 \uC601\uD63C\uC73C\uB85C
        \uB458\uB7EC\uC2F8\uC774\uBA74 \uC601\uD63C\uC758 \uC601\uD5A5\uC744 \uBC1B\uC544
        \uD615\uD0DC\uAC00 \uBC14\uB00C\uAC8C \uB3FC. "
      StateToTrigger: 0
      StateTriggerTiming: 0
      FigurePosition: 0
      FigureSprite: {fileID: 0}
      AdditionalFigurePosition: 0
      AdditionalFigureSprite: {fileID: 0}
      TertiaryFigurePosition: 0
      TertiaryFigureSprite: {fileID: 0}
      HideFiguresAfterDialogue: 0
    - SpeakerName: "\uB098"
      DialogueText: "\uAC00\uB85C \uC138\uB85C \uB300\uAC01\uC120 \uC5B4\uB5A4 \uBC29\uD5A5\uC774\uB4E0
        \uC0C1\uAD00\uC5C6\uC5B4. \uD558\uC9C0\uB9CC \uC77C\uB2E8 \uC9C0\uAE08\uC740
        \uC138\uB85C \uBC29\uD5A5\uC73C\uB85C \uC601\uD63C\uC744 \uC2EC\uC5B4 \uBCF4\uC790."
      StateToTrigger: 2
      StateTriggerTiming: 0
      FigurePosition: 0
      FigureSprite: {fileID: 0}
      AdditionalFigurePosition: 0
      AdditionalFigureSprite: {fileID: 0}
      TertiaryFigurePosition: 0
      TertiaryFigureSprite: {fileID: 0}
      HideFiguresAfterDialogue: 1
  - Entries:
    - SpeakerName: "\uB098"
      DialogueText: "\uB410\uB2E4! \uBC14\uAF08\uC5B4."
      StateToTrigger: 0
      StateTriggerTiming: 0
      FigurePosition: 3
      FigureSprite: {fileID: 21300000, guid: c2e5561806978e54681092b2776eabc9, type: 3}
      AdditionalFigurePosition: 0
      AdditionalFigureSprite: {fileID: 0}
      TertiaryFigurePosition: 0
      TertiaryFigureSprite: {fileID: 0}
      HideFiguresAfterDialogue: 0
    - SpeakerName: "\uB098"
      DialogueText: "\uC774\uB7F0 \uC2DD\uC73C\uB85C \uC6D0\uB798 \uC790\uB9AC \uC7A1\uACE0
        \uC788\uB358 \uAC80\uC740\uC0C9 \uAC10\uC815\uB4E4\uC744 \uC77C\uC815 \uAC1C\uC218
        \uC774\uC0C1 \uBCC0\uD658\uC2DC\uD0A4\uBA74 \uC774 \uC0AC\uB78C\uC744 \uC124\uB4DD\uD560
        \uC218 \uC788\uC744 \uAC70\uC57C. "
      StateToTrigger: 0
      StateTriggerTiming: 0
      FigurePosition: 0
      FigureSprite: {fileID: 0}
      AdditionalFigurePosition: 0
      AdditionalFigureSprite: {fileID: 0}
      TertiaryFigurePosition: 0
      TertiaryFigureSprite: {fileID: 0}
      HideFiguresAfterDialogue: 0
    - SpeakerName: "\uACBD\uBE44\uC6D0"
      DialogueText: "\u2026.."
      StateToTrigger: 0
      StateTriggerTiming: 0
      FigurePosition: 3
      FigureSprite: {fileID: 0}
      AdditionalFigurePosition: 1
      AdditionalFigureSprite: {fileID: 21300000, guid: f8872d8ce4fc5484789f2054c88ae15c, type: 3}
      TertiaryFigurePosition: 0
      TertiaryFigureSprite: {fileID: 0}
      HideFiguresAfterDialogue: 0
    - SpeakerName: "\uACBD\uBE44\uC6D0"
      DialogueText: "\uBB50\uC57C\u2026? \uB0B4 \uBA38\uB9AC\uC5D0 \uBB54\uAC00\u2026."
      StateToTrigger: 0
      StateTriggerTiming: 0
      FigurePosition: 3
      FigureSprite: {fileID: 21300000, guid: 705fd1421212095459b15a83898eaff8, type: 3}
      AdditionalFigurePosition: 0
      AdditionalFigureSprite: {fileID: 0}
      TertiaryFigurePosition: 0
      TertiaryFigureSprite: {fileID: 0}
      HideFiguresAfterDialogue: 0
    - SpeakerName: "\uB098"
      DialogueText: "\u2026..!"
      StateToTrigger: 0
      StateTriggerTiming: 0
      FigurePosition: 0
      FigureSprite: {fileID: 0}
      AdditionalFigurePosition: 0
      AdditionalFigureSprite: {fileID: 0}
      TertiaryFigurePosition: 0
      TertiaryFigureSprite: {fileID: 0}
      HideFiguresAfterDialogue: 0
    - SpeakerName: "\uB098"
      DialogueText: "\uC544\u2026. \uB9DE\uB2E4. \uD55C \uBC88\uC5D0 \uB108\uBB34
        \uB9CE\uC740 \uC601\uD63C\uC744 \uC5B5\uC9C0\uB85C \uC2EC\uC5B4\uB123\uB2E4
        \uBCF4\uBA74 \uC774 \uC0AC\uB78C\uC774 \uBB54\uAC00 \uC774\uC0C1\uD55C \uB290\uB08C\uC744
        \uBC1B\uC744 \uC218\uB3C4 \uC788\uC5B4\u2026."
      StateToTrigger: 0
      StateTriggerTiming: 0
      FigurePosition: 0
      FigureSprite: {fileID: 0}
      AdditionalFigurePosition: 0
      AdditionalFigureSprite: {fileID: 0}
      TertiaryFigurePosition: 0
      TertiaryFigureSprite: {fileID: 0}
      HideFiguresAfterDialogue: 0
    - SpeakerName: "\uB098"
      DialogueText: "\uC2EC\uC9C0\uC5B4 \uC9C0\uAE08 \uB09C \uB9C8\uB140\uB77C\uB294
        \uC758\uC2EC\uC744 \uBC1B\uACE0 \uC788\uB294 \uC0C1\uD669\uC774\uB2C8\uAE4C,
        \uC870\uC2EC\uD574\uC57C \uD560 \uAC83 \uAC19\uB124."
      StateToTrigger: 0
      StateTriggerTiming: 0
      FigurePosition: 3
      FigureSprite: {fileID: 21300000, guid: 9f7722c6ab0348b418d8400e510da437, type: 3}
      AdditionalFigurePosition: 0
      AdditionalFigureSprite: {fileID: 0}
      TertiaryFigurePosition: 0
      TertiaryFigureSprite: {fileID: 0}
      HideFiguresAfterDialogue: 0
    - SpeakerName: "\uB098"
      DialogueText: "\uC601\uD63C\uC744 \uD55C \uAC1C \uC2EC\uB294 \uAC74 \uC758\uC2EC\uC744
        \uB9CE\uC774 \uC0AC\uC9C4 \uC54A\uACA0\uC9C0\uB9CC, \uD55C \uBC88\uC5D0 \uB450
        \uAC1C, \uC138 \uAC1C\uC529 \uC2EC\uC73C\uBA74 \uC758\uC2EC\uB3C4\uAC00 \uD06C\uAC8C
        \uC624\uB97C \uAC70\uC57C."
      StateToTrigger: 3
      StateTriggerTiming: 1
      FigurePosition: 0
      FigureSprite: {fileID: 0}
      AdditionalFigurePosition: 0
      AdditionalFigureSprite: {fileID: 0}
      TertiaryFigurePosition: 0
      TertiaryFigureSprite: {fileID: 0}
      HideFiguresAfterDialogue: 0
    - SpeakerName: "\uB098"
      DialogueText: "\uC77C\uB2E8 \uC9C0\uAE08\uC740 \uC601\uD63C \uC2EC\uB294 \uAC78
        \uC7A0\uAE50 \uBA48\uCDB0\uC57C\uACA0\uC5B4."
      StateToTrigger: 4
      StateTriggerTiming: 0
      FigurePosition: 0
      FigureSprite: {fileID: 0}
      AdditionalFigurePosition: 0
      AdditionalFigureSprite: {fileID: 0}
      TertiaryFigurePosition: 0
      TertiaryFigureSprite: {fileID: 0}
      HideFiguresAfterDialogue: 1
