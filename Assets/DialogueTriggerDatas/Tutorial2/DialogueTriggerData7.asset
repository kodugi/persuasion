    - SpeakerName: "\uB098"
      DialogueText: "\uC544\uC9C1 \uB4E4\uD0A4\uC9C0\uB3C4 \uC54A\uC740 \uAC83 \uAC19\uACE0\u2026...
        \uB2E4\uD589\uC774\uB2E4."
      StateToTrigger: 0
      StateTriggerTiming: 0
    - SpeakerName: "\uB098"
      DialogueText: "\uD558\uC9C0\uB9CC \uD55C \uBC88 \uC131\uACF5\uD588\uB2E4\uACE0
        \uD574\uC11C \uC88B\uC544\uD558\uBA74 \uC548\uB3FC. \uC0AC\uB78C\uC758 \uC758\uC2DD\uC5D0\uB294
        \uCE35\uC704\uAC00 \uC788\uC73C\uB2C8\uAE4C."
      StateToTrigger: 21
      StateTriggerTiming: 1
    - SpeakerName: "\uB098"
      DialogueText: "\uC774\uC804 \uCE35\uC758 \uAC80\uC740 \uAC10\uC815\uB4E4\uC744
        \uBAA9\uD45C\uCE58\uB9CC\uD07C \uBCC0\uD658\uC2DC\uD0A4\uBA74 \uB354 \uAE4A\uC740
        \uCE35\uC73C\uB85C \uB4E4\uC5B4\uAC08 \uC218 \uC788\uC5B4."
      StateToTrigger: 0
      StateTriggerTiming: 0
    - SpeakerName: "\uB098"
      DialogueText: "\uADF8\uB9AC\uACE0 \uAC00\uC7A5 \uAE4A\uC740 \uC758\uC2DD\uC758
        \uCE35\uC5D0\uC11C \uAC80\uC740 \uAC10\uC815\uB4E4\uC744 \uBAA9\uD45C\uCE58\uB9CC\uD07C
        \uBCC0\uD658\uC2DC\uCF1C\uC57C \uBE44\uB85C\uC18C \uC0C1\uB300\uAC00 \uC628\uC804\uD788
        \uC124\uB4DD\uC774 \uB3FC."
      StateToTrigger: 0
      StateTriggerTiming: 0
    - SpeakerName: "\uB098"
      DialogueText: "\uC774 \uC0AC\uB78C\uC740 \uC774\uAC8C \uB9C8\uC9C0\uB9C9 \uCE35\uC778
        \uAC83 \uAC19\uB124."
      StateToTrigger: 0
      StateTriggerTiming: 0
    - SpeakerName: "\uB098"
      DialogueText: "\uC5EC\uAE30\uB9CC \uD574\uACB0\uD558\uBA74 \uC774 \uC0AC\uB78C\uC744
        \uC644\uC804\uD788 \uC124\uB4DD\uC2DC\uD0AC \uC218 \uC788\uC744 \uAC70\uC57C."
